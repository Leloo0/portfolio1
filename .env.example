# Banco de dados (SQLite local).
# O caminho é relativo à pasta prisma/ (onde fica o schema.prisma).
DATABASE_URL=file:../db/custom.db

# Na Vercel este arquivo NÃO é usado — a URL é resolvida automaticamente
# pelo código (banco efêmero em /tmp). Para um banco persistente na Vercel,
# use um serviço como Turso/Neon/Supabase e defina DATABASE_URL no painel.
